{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex-usage-pet/schemas/usage-snapshot.schema.json",
  "title": "Codex Usage Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "observedAt", "status", "windows"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": { "enum": ["codex-app-server", "snapshot-file", "mock"] },
    "sourceVersion": { "type": ["string", "null"] },
    "observedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["available", "stale", "unavailable"] },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fiveHour", "weekly"],
      "properties": {
        "fiveHour": { "$ref": "#/$defs/window" },
        "weekly": { "$ref": "#/$defs/window" }
      }
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  },
  "$defs": {
    "window": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["windowDurationMinutes", "usedPercent", "remainingPercent", "resetsAt"],
      "properties": {
        "windowDurationMinutes": { "type": "integer", "minimum": 1 },
        "usedPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "remainingPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "resetsAt": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}

