<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>CodexUsagePet</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodexUsagePet.Core\CodexUsagePet.Core.csproj" />
    <Content Include="..\..\config\defaults.json" Link="config\defaults.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\pets\fengjin\spritesheet-preview.png" Link="assets\fengjin\spritesheet-preview.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
