<Window x:Class="CodexUsagePet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 用量桌宠"
        Width="320"
        Height="390"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded">
    <Grid>
        <Border x:Name="UsageBubble"
                Width="270"
                Padding="15,11"
                Margin="0,0,0,286"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="#FFFDF8EE"
                BorderBrush="#FFD88DA8"
                BorderThickness="2"
                CornerRadius="18"
                Visibility="Collapsed">
            <TextBlock x:Name="UsageText"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="14"
                       Foreground="#FF5A3444"
                       TextWrapping="Wrap" />
        </Border>

        <Grid x:Name="PetSurface"
              Width="240"
              Height="270"
              Margin="0,0,0,8"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              MouseEnter="PetSurface_MouseEnter"
              MouseLeave="PetSurface_MouseLeave">
            <Ellipse Width="68" Height="174" Margin="0,46,144,0"
                     HorizontalAlignment="Center" VerticalAlignment="Top"
                     Fill="#FFF19DBB" Stroke="#FF8F526C" StrokeThickness="3" />
            <Ellipse Width="68" Height="174" Margin="144,46,0,0"
                     HorizontalAlignment="Center" VerticalAlignment="Top"
                     Fill="#FFF19DBB" Stroke="#FF8F526C" StrokeThickness="3" />

            <Path Data="M 72,166 L 120,134 L 168,166 L 187,244 L 53,244 Z"
                  Fill="#FFC94E63" Stroke="#FF7D3449" StrokeThickness="4" />
            <Path Data="M 84,169 L 120,145 L 156,169 L 146,231 L 94,231 Z"
                  Fill="#FFFFF7EC" Stroke="#FFD6A05D" StrokeThickness="3" />
            <Ellipse Width="148" Height="142" Margin="0,28,0,0"
                     HorizontalAlignment="Center" VerticalAlignment="Top"
                     Fill="#FFFFE4D8" Stroke="#FF8F526C" StrokeThickness="4" />
            <Path Data="M 52,90 C 57,25 177,18 188,92 C 155,68 91,67 52,90 Z"
                  Fill="#FFF08FAF" Stroke="#FF8F526C" StrokeThickness="4" />

            <TextBlock x:Name="FaceGlyph"
                       Margin="0,76,0,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="31"
                       FontWeight="SemiBold"
                       Foreground="#FF3E6C68"
                       Text="◕‿◕" />

            <Ellipse Width="18" Height="18" Margin="105,151,0,0"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Fill="#FFF5C84C" Stroke="#FF9F6E2D" StrokeThickness="2" />

            <Border x:Name="HeadHitArea"
                    Width="154" Height="145" Margin="0,25,0,0"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Background="#01FFFFFF"
                    Cursor="Hand"
                    MouseLeftButtonDown="HeadHitArea_MouseLeftButtonDown" />
            <Border Width="152" Height="92" Margin="0,0,0,18"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Background="#01FFFFFF"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="BodyDragArea_MouseLeftButtonDown" />

            <Border Margin="0,0,0,0" Padding="8,4"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Background="#CCFFFFFF" CornerRadius="10">
                <TextBlock x:Name="StateText"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="12"
                           Foreground="#FF6D4253"
                           Text="直视" />
            </Border>
        </Grid>
    </Grid>
</Window>

