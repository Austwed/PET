<Window x:Class="CodexUsagePet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 用量桌宠"
        Width="320"
        Height="390"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded">
    <Grid>
        <Border x:Name="UsageBubble"
                Width="270"
                Padding="15,11"
                Margin="0,0,0,286"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="#FFFDF8EE"
                BorderBrush="#FFD88DA8"
                BorderThickness="2"
                CornerRadius="18"
                Visibility="Collapsed">
            <TextBlock x:Name="UsageText"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="14"
                       Foreground="#FF5A3444"
                       TextWrapping="Wrap" />
        </Border>

        <Grid x:Name="PetSurface"
              Width="240"
              Height="270"
              Margin="0,0,0,8"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              MouseEnter="PetSurface_MouseEnter"
              MouseLeave="PetSurface_MouseLeave">
            <Image x:Name="PetImage"
                   Width="240"
                   Height="260"
                   Margin="0,0,0,8"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SnapsToDevicePixels="True" />

            <Border x:Name="HeadHitArea"
                    Width="154" Height="145" Margin="0,25,0,0"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Background="#01FFFFFF"
                    Cursor="Hand"
                    MouseLeftButtonDown="HeadHitArea_MouseLeftButtonDown" />
            <Border Width="152" Height="92" Margin="0,0,0,18"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Background="#01FFFFFF"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="BodyDragArea_MouseLeftButtonDown" />

            <Border Margin="0,0,0,0" Padding="8,4"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Background="#CCFFFFFF" CornerRadius="10">
                <TextBlock x:Name="StateText"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="12"
                           Foreground="#FF6D4253"
                           Text="直视" />
            </Border>
        </Grid>
    </Grid>
</Window>
